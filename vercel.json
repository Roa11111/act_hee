{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "MYSQL_HOST": "@mysql-host",
    "MYSQL_PORT": "@mysql-port",
    "MYSQL_USER": "@mysql-user",
    "MYSQL_PASSWORD": "@mysql-password",
    "MYSQL_DATABASE": "@mysql-database",
    "MYSQL_SSL_CA": "@mysql-ssl-ca"
  }
}
